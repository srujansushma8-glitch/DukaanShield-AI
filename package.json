{
  "name": "dukaanshield-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test --test-concurrency=1 backend/tests/*.test.js && vitest run",
    "test:backend": "node --test --test-concurrency=1 backend/tests/*.test.js",
    "test:frontend": "vitest run",
    "benchmark": "node backend/benchmark/run.js",
    "server": "node backend/server.js",
    "start": "node backend/server.js",
    "dev:all": "concurrently \"node backend/server.js\" \"vite\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.81.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
