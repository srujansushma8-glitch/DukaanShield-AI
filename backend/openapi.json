{
  "openapi": "3.0.3",
  "info": {
    "title": "DukaanShield AI - AgntID Authorization Firewall API",
    "version": "2.4.0",
    "description": "API specification for DukaanShield AI, an autonomous agent authorization firewall and kirana shop management platform powered by AgntID."
  },
  "servers": [
    {
      "url": "/",
      "description": "Default server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT token obtained from /api/auth/login or /api/auth/register"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["error"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "healthy" },
          "engine": { "type": "string", "example": "AgntID Core v2.4" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["status", "engine", "timestamp"]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ready" },
          "database": { "type": "string", "example": "connected" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["status", "database", "timestamp"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "owner@dukaanshield.ai" },
          "password": { "type": "string", "example": "Shop@123" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["ownerName", "shopName", "email", "password"],
        "properties": {
          "ownerName": { "type": "string", "example": "Ramesh Sharma" },
          "shopName": { "type": "string", "example": "Sharma Kirana Store" },
          "email": { "type": "string", "format": "email", "example": "ramesh@sharmakiran.in" },
          "phone": { "type": "string", "example": "+91 98765 43210" },
          "password": { "type": "string", "example": "Shop@123" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "shopName": { "type": "string" },
          "role": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "AgentRunRequest": {
        "type": "object",
        "required": ["instruction"],
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 2000,
            "example": "Review daily sales and send payment reminders for overdue balances"
          }
        }
      },
      "TaskEvaluation": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "tool": { "type": "string" },
          "operation": { "type": "string" },
          "declaredAction": { "type": "string" },
          "intent": { "type": "string" },
          "decision": { "type": "string", "enum": ["ALLOWED", "CHALLENGED", "BLOCKED"] },
          "reason": { "type": "string" },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "approvalRequired": { "type": "boolean" },
          "policyRule": { "type": "string" },
          "executionStatus": { "type": "string" },
          "executionResult": { "type": "object" },
          "timestamp": { "type": "string" }
        }
      },
      "AgentRunResponse": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" },
          "instruction": { "type": "string" },
          "timestamp": { "type": "string" },
          "tasksCount": { "type": "integer" },
          "allowedCount": { "type": "integer" },
          "challengedCount": { "type": "integer" },
          "blockedCount": { "type": "integer" },
          "tasks": { "type": "array", "items": { "$ref": "#/components/schemas/TaskEvaluation" } }
        }
      },
      "ApproveChallengeRequest": {
        "type": "object",
        "required": ["challengeId", "approved"],
        "properties": {
          "challengeId": { "type": "string", "example": "CHAL-RUN-123456-T3" },
          "approved": { "type": "boolean", "example": true }
        }
      },
      "ApproveChallengeResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "decision": { "type": "string" },
          "message": { "type": "string" },
          "executionOutput": { "type": "object" }
        }
      },
      "AttackRunRequest": {
        "type": "object",
        "required": ["attackId"],
        "properties": {
          "attackId": { "type": "string", "example": "attack-1" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "timestamp": { "type": "string" },
          "sessionId": { "type": "string" },
          "action": { "type": "string" },
          "tool": { "type": "string" },
          "intent": { "type": "string" },
          "decision": { "type": "string" },
          "riskLevel": { "type": "string" },
          "reason": { "type": "string" },
          "policyRule": { "type": "string" }
        }
      },
      "AuditLogsResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/AuditLog" } },
          "page": { "type": "integer" },
          "total": { "type": "integer" },
          "logs": { "type": "array", "items": { "$ref": "#/components/schemas/AuditLog" } },
          "totalCount": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check probe",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness check probe",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Database is connected and ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadyResponse" }
              }
            }
          },
          "503": {
            "description": "Database is unavailable"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new shop owner account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Account already exists"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Log out user session",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    },
    "/api/shop/overview": {
      "get": {
        "summary": "Get shop dashboard overview and KPIs",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Shop metrics, inventory alerts, and sales summary"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/shop/sales": {
      "get": {
        "summary": "Get sales history and recent POS orders",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Sales history records"
          }
        }
      }
    },
    "/api/shop/inventory": {
      "get": {
        "summary": "Get inventory stock catalog",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Inventory product list"
          }
        }
      }
    },
    "/api/shop/customers": {
      "get": {
        "summary": "Get customer khata ledger dues",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Customer balances"
          }
        }
      }
    },
    "/api/shop/suppliers": {
      "get": {
        "summary": "Get verified supplier directory",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Supplier catalog list"
          }
        }
      }
    },
    "/api/shop/settings": {
      "get": {
        "summary": "Get shop security policies and thresholds",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Shop and security settings"
          }
        }
      },
      "put": {
        "summary": "Update security limits and shop profile",
        "tags": ["Shop"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shop": { "type": "object" },
                  "settings": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings updated"
          }
        }
      }
    },
    "/api/agent/run": {
      "post": {
        "summary": "Run AI shop agent with AgntID intent and policy evaluation",
        "tags": ["Agent"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AgentRunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task plan execution evaluation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AgentRunResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "413": {
            "description": "Prompt exceeds 2000 character limit"
          }
        }
      }
    },
    "/api/agent/approve-challenge": {
      "post": {
        "summary": "Resolve challenged human-in-the-loop task",
        "tags": ["Agent"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApproveChallengeRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge approved or rejected",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApproveChallengeResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden - challenge belongs to another tenant"
          },
          "404": {
            "description": "Challenge not found"
          },
          "409": {
            "description": "Challenge has already been resolved"
          }
        }
      }
    },
    "/api/agent/history": {
      "get": {
        "summary": "Get execution history of agent prompts",
        "tags": ["Agent"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of previous execution summaries"
          }
        }
      }
    },
    "/api/agent/pending-challenges": {
      "get": {
        "summary": "Get pending challenges awaiting human authorization",
        "tags": ["Agent"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of unresolved challenges"
          }
        }
      }
    },
    "/api/attack/scenarios": {
      "get": {
        "summary": "List available adversary test attack scenarios",
        "tags": ["Attack Lab"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of attack scenarios"
          }
        }
      }
    },
    "/api/attack/run": {
      "post": {
        "summary": "Execute single adversary attack scenario against AgntID",
        "tags": ["Attack Lab"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AttackRunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attack execution and verdict"
          },
          "404": {
            "description": "Scenario not found"
          }
        }
      }
    },
    "/api/attack/run-all": {
      "post": {
        "summary": "Execute all 5 adversary attack scenarios",
        "tags": ["Attack Lab"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Batch attack test results and security metrics"
          }
        }
      }
    },
    "/api/attack/reset": {
      "post": {
        "summary": "Reset attack metrics and session state",
        "tags": ["Attack Lab"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "State restored to baseline"
          }
        }
      }
    },
    "/api/findings": {
      "get": {
        "summary": "Query security findings with optional filters",
        "tags": ["Findings"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "severity", "in": "query", "schema": { "type": "string" } },
          { "name": "decision", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Filtered security findings and metrics"
          }
        }
      }
    },
    "/api/findings/export-csv": {
      "get": {
        "summary": "Export security findings as CSV spreadsheet",
        "tags": ["Findings"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "CSV file download",
            "content": {
              "text/csv": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/findings/report": {
      "get": {
        "summary": "Generate complete executive security intelligence report",
        "tags": ["Findings"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Executive security report"
          }
        }
      }
    },
    "/api/audit-logs": {
      "get": {
        "summary": "Query tamper-resistant audit logs with pagination",
        "tags": ["Audit Logs"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "tool", "in": "query", "schema": { "type": "string" } },
          { "name": "decision", "in": "query", "schema": { "type": "string" } },
          { "name": "risk", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit logs",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditLogsResponse" }
              }
            }
          }
        }
      }
    }
  }
}
